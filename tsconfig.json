{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "jest.config.ts",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}