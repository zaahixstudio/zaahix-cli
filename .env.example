# Zaahix CLI Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control!

# ─── Active Provider ──────────────────────────────────────────────────────────
# Options: openai | groq | gemini | openrouter | sambanova | longcat | omniroute
ZAAHIX_PROVIDER=omniroute

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.2

# Optional: Use local Ollama instead of cloud APIs
# USE_OLLAMA=false
# OLLAMA_MODEL=qwen2.5-coder:7b

# ─── Google Gemini (supports multiple keys for rotation) ──────────────────────
# GEMINI_API_KEY_1=your_gemini_api_key_1
# GEMINI_API_KEY_2=your_gemini_api_key_2
# GEMINI_API_KEY_3=your_gemini_api_key_3
# GEMINI_MODEL=gemini-2.0-flash-lite
# GEMINI_CHAT_MODEL=gemini-2.0-flash-lite
# GEMINI_CODE_MODEL=gemini-2.0-flash-lite

# ─── Groq ─────────────────────────────────────────────────────────────────────
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# GROQ_CODE_MODEL=llama-3.3-70b-versatile

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_REFERER=https://github.com/yourusername/zaahix-cli
# OPENROUTER_TITLE=Zaahix CLI

# ─── SambaNova ────────────────────────────────────────────────────────────────
# SAMBANOVA_API_KEY=your_sambanova_api_key_here
# SAMBANOVA_CHAT_MODEL=Meta-Llama-3.1-8B-Instruct
# SAMBANOVA_CODE_MODEL=Meta-Llama-3.3-70B-Instruct

# ─── LongCat ──────────────────────────────────────────────────────────────────
# LONGCAT_API_KEY=your_longcat_api_key_here
# LONGCAT_MODEL=LongCat-2.0

# ─── OmniRoute (Local AI Gateway) ────────────────────────────────────────────
# OmniRoute runs locally and provides access to 230+ AI providers
# Install: npm install -g omniroute
# Start: omniroute
# Dashboard: http://localhost:20128
# Generate API key from dashboard (optional - "omniroute-local" works for local use)
OMNIROUTE_API_KEY=omniroute-local
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_MODEL=openai/gpt-4o-mini
# OMNIROUTE_CHAT_MODEL=openai/gpt-4o-mini
# OMNIROUTE_CODE_MODEL=openai/gpt-4o-mini

# ─── Agent Behavior ───────────────────────────────────────────────────────────
# ZAAHIX_AUTO_APPROVE=false
# ZAAHIX_ALLOW_NON_INTERACTIVE=false